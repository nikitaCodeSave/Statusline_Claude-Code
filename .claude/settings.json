{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh release:*)",
      "Bash(gh repo view:*)",
      "Edit(/CLAUDE.md)",
      "Edit(/GLOSSARY.md)",
      "Edit(/docs/**)",
      "Edit(/.claude/skills/**)"
    ],
    "ask": [
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)"
    ],
    "deny": [
      "Edit(/.git/**)",
      "Edit(/.claude-plugin/types/**)",
      "Edit(//etc/claude-code/**)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin +:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh release delete:*)"
    ]
  }
}
