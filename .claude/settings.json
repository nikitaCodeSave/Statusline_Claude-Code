{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)"
    ],
    "deny": [
      "Edit(/.git/**)",
      "Edit(/.claude-plugin/types/**)",
      "Edit(//etc/claude-code/**)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
